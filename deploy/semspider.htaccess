# Front controller de SemSpider, servi depuis un sous-dossier.
DirectoryIndex index.php
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Calcule le préfixe du dossier (ex. /semspider) sans le coder en dur.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # Les fichiers statiques existants (css, favicon) sont servis directement.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

# Cache navigateur long : CSS et JS sont versionnés (?v=), le favicon change rarement.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
